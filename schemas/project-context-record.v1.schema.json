{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "supervise-repo-loop/project-context-record.v1",
  "title": "Project-wide current-context reconciliation event v1",
  "type": "object",
  "required": [
    "repository_id", "project_context_revision", "project_context_event_id",
    "based_on_project_context_revision", "source_actor", "source_message_id",
    "authority_revision", "authority_fingerprint", "north_star",
    "current_bottleneck", "completion_definition", "roadmap", "active_lanes",
    "lane_frontier_event_ids", "cross_lane_conflicts", "decisions_since_prior",
    "evidence_manifest", "omitted_evidence", "supersedes_context_event_ids",
    "recorded_at"
  ],
  "properties": {
    "repository_id": {"type": "string", "minLength": 1},
    "project_context_revision": {"type": "integer", "minimum": 1},
    "project_context_event_id": {"type": "string", "minLength": 1},
    "based_on_project_context_revision": {"type": "integer", "minimum": 0},
    "source_actor": {"enum": ["human", "supervisor", "worker", "repo_observation", "coordinator"]},
    "source_message_id": {"type": "string", "minLength": 1},
    "authority_revision": {"type": "string", "minLength": 1},
    "authority_fingerprint": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "north_star": {"type": "string", "minLength": 1},
    "current_bottleneck": {"type": "string", "minLength": 1},
    "completion_definition": {"type": "string", "minLength": 1},
    "roadmap": {
      "type": "object",
      "required": ["overall_position", "current_block", "next_gate", "completion_definition", "completed_blocks", "next_blocks"],
      "properties": {
        "overall_position": {"type": "string", "minLength": 1},
        "current_block": {"type": "string", "minLength": 1},
        "next_gate": {"type": "string", "minLength": 1},
        "completion_definition": {"type": "string", "minLength": 1},
        "completed_blocks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "next_blocks": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "active_lanes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "lane_frontier_event_ids": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "cross_lane_conflicts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "decisions_since_prior": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "lane_id", "disposition", "source_actor"],
        "properties": {
          "event_id": {"type": "string", "minLength": 1},
          "lane_id": {"type": "string", "minLength": 1},
          "disposition": {"enum": ["active", "accepted", "rejected", "superseded", "parked", "none"]},
          "source_actor": {"enum": ["human", "supervisor", "worker", "repo_observation", "coordinator"]}
        },
        "additionalProperties": false
      }
    },
    "evidence_manifest": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "kind", "locator", "authority_role", "sha256"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "authority_role": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "omitted_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "reason"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "supersedes_context_event_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "recorded_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
