{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "supervise-repo-loop/binding-registry.v2",
  "title": "Separated supervision binding registry v2",
  "type": "object",
  "required": [
    "schema_version",
    "repositories",
    "supervisor_bindings",
    "worker_bindings"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "coordinator_policy": {
      "type": "object",
      "properties": {
        "allow_create_worker_task": {
          "type": "boolean"
        },
        "allow_create_supervisor_chat": {
          "type": "boolean"
        },
        "user_visible_codex_entry_points": {
          "const": 1
        },
        "mission_specific_worker_creation": {
          "const": false
        },
        "user_input_surface": {
          "const": "coordinator"
        }
      },
      "additionalProperties": true
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "repository_id",
          "aliases",
          "default_supervision_lane",
          "remote_identity"
        ],
        "properties": {
          "schema_version": {
            "const": 2
          },
          "repository_id": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "default_supervision_lane": {
            "type": "string",
            "minLength": 1
          },
          "remote_identity": {
            "type": "string",
            "minLength": 1
          },
          "stable_order": {
            "type": "integer",
            "minimum": 0
          },
          "allow_request_next_mission": {
            "type": "boolean"
          },
          "authority_watch": {
            "type": "array",
            "items": {
              "oneOf": [
                {"type": "string", "minLength": 1},
                {
                  "type": "object",
                  "required": ["path"],
                  "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "role": {"type": "string", "minLength": 1}
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "additionalProperties": true
      }
    },
    "supervisor_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "repository_id",
          "supervision_lane",
          "supervisor_project_id",
          "supervisor_thread_id",
          "expected_supervisor_title",
          "last_verified_at",
          "binding_status",
          "allow_create_supervisor_chat"
        ],
        "properties": {
          "schema_version": {
            "const": 2
          },
          "repository_id": {
            "type": "string",
            "minLength": 1
          },
          "supervision_lane": {
            "type": "string",
            "minLength": 1
          },
          "supervisor_project_id": {
            "type": ["string", "null"]
          },
          "supervisor_thread_id": {
            "type": ["string", "null"]
          },
          "expected_supervisor_title": {
            "type": ["string", "null"]
          },
          "last_verified_at": {
            "type": ["string", "null"]
          },
          "binding_status": {
            "enum": ["active", "needs_verification", "inactive", "invalid"]
          },
          "allow_create_supervisor_chat": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "worker_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "repository_id",
          "worker_task_id",
          "host_id",
          "root_hint",
          "last_verified_at",
          "binding_status",
          "allow_create_worker_task"
        ],
        "properties": {
          "schema_version": {
            "const": 2
          },
          "repository_id": {
            "type": "string",
            "minLength": 1
          },
          "worker_task_id": {
            "type": ["string", "null"]
          },
          "host_id": {
            "type": "string",
            "minLength": 1
          },
          "root_hint": {
            "type": ["string", "null"]
          },
          "last_verified_at": {
            "type": ["string", "null"]
          },
          "binding_status": {
            "enum": ["active", "needs_verification", "inactive", "invalid"]
          },
          "allow_create_worker_task": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
