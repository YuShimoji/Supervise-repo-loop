{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "supervise-repo-loop/work-order.v2",
  "title": "Compact Supervisor Work Order v2",
  "type": "object",
  "required": [
    "schema_version",
    "packet_type",
    "protocol_ref",
    "mission_delta",
    "packet_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "packet_type": {
      "const": "SUPERVISOR_WORK_ORDER"
    },
    "protocol_ref": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "const": "references/protocol-v2.md"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "mission_delta": {
      "type": "object",
      "required": [
        "repository_id",
        "mission_id",
        "attempt_id",
        "authority_revision",
        "active_artifact",
        "canonical_revision",
        "read_scope",
        "write_scope",
        "acceptance_delta",
        "stop_delta",
        "external_effects"
      ]
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
