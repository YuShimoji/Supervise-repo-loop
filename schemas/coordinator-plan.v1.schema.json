{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "supervise-repo-loop/coordinator-plan.v1",
  "title": "Coordinator deterministic cycle plan v1",
  "type": "object",
  "required": [
    "classification",
    "state_fingerprint",
    "next_action",
    "has_ready_action",
    "has_inflight_work",
    "cycle_should_continue_now",
    "cycle_checkpoint_allowed",
    "watchdog_should_be_armed",
    "watchdog_should_be_paused"
  ],
  "properties": {
    "classification": {"const": "COORDINATOR_DETERMINISTIC_PLAN"},
    "state_fingerprint": {"type": "string", "minLength": 64},
    "next_action": {"type": ["object", "null"]},
    "has_ready_action": {"type": "boolean"},
    "has_inflight_work": {"type": "boolean"},
    "cycle_should_continue_now": {"type": "boolean"},
    "cycle_checkpoint_allowed": {"type": "boolean"},
    "watchdog_should_be_armed": {"type": "boolean"},
    "watchdog_should_be_paused": {"type": "boolean"},
    "coordinator_lifecycle": {"const": "AVAILABLE"},
    "coordinator_availability": {"const": "AVAILABLE"},
    "execution_state": {
      "enum": ["READY", "DRAINING", "WAITING_USER", "WAITING_EXTERNAL", "IDLE"]
    }
  },
  "additionalProperties": true
}
