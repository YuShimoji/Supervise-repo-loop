{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "supervise-repo-loop/coordinator-portfolio.v2",
  "title": "Coordinator graphical portfolio status v2",
  "type": "object",
  "required": [
    "schema_version",
    "semantic_fingerprint",
    "coordinator_availability",
    "execution_state",
    "scheduler_revision",
    "active_route_count",
    "active_routes",
    "concurrency_limit",
    "next_user_action",
    "repositories"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "semantic_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "coordinator_availability": {"const": "AVAILABLE"},
    "execution_state": {
      "enum": ["READY", "DRAINING", "WAITING_USER", "WAITING_EXTERNAL", "IDLE", "SAFETY_CEILING"]
    },
    "scheduler_revision": {"type": "integer", "minimum": 0},
    "active_route_count": {"type": "integer", "minimum": 0},
    "active_routes": {
      "type": "array",
      "items": {"$ref": "#/$defs/activeRoute"}
    },
    "concurrency_limit": {"type": "integer", "minimum": 1, "maximum": 8},
    "next_user_action": {
      "anyOf": [
        {"type": "null"},
        {"$ref": "#/$defs/userAction"}
      ]
    },
    "repositories": {
      "type": "array",
      "items": {"$ref": "#/$defs/repository"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "userAction": {
      "type": "object",
      "required": [
        "repository_id",
        "kind",
        "purpose",
        "why_now",
        "entrypoint",
        "requirements",
        "reply_format",
        "owner",
        "post_reply_behavior",
        "non_escalation_boundary"
      ],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["USER_DECISION", "USER_ACTION"]},
        "purpose": {"type": "string", "minLength": 1},
        "why_now": {"type": "string", "minLength": 1},
        "entrypoint": {"type": "string", "minLength": 1},
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "reply_format": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "post_reply_behavior": {"type": "string", "minLength": 1},
        "non_escalation_boundary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "roadmap": {
      "type": "object",
      "required": [
        "overall_position",
        "current_block",
        "completed_blocks",
        "next_blocks",
        "completion_definition",
        "next_gate"
      ],
      "properties": {
        "overall_position": {"type": "string", "minLength": 1},
        "current_block": {"type": "string", "minLength": 1},
        "completed_blocks": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "next_blocks": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "completion_definition": {"type": "string", "minLength": 1},
        "next_gate": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "activeRoute": {
      "type": "object",
      "required": [
        "repository_id",
        "action_id",
        "recipient_thread_id",
        "observer_kind",
        "delivery_token",
        "after_cursor",
        "status"
      ],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1},
        "action_id": {"type": "string", "minLength": 1},
        "recipient_thread_id": {"type": "string", "minLength": 1},
        "observer_kind": {"enum": ["codex_wait", "chatgpt_poll"]},
        "delivery_token": {"type": "string", "minLength": 1},
        "after_cursor": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "status": {"enum": ["prepared", "sent", "waiting"]}
      },
      "additionalProperties": true
    },
    "stage": {
      "enum": [
        "MISSION",
        "WORK_ORDER",
        "WORKER",
        "WORKER_REPORT",
        "SUPERVISOR",
        "VERDICT",
        "NEXT_ROUTE"
      ]
    },
    "introducedBy": {
      "type": "object",
      "required": ["event", "at", "evidence"],
      "properties": {
        "event": {"type": "string", "minLength": 1},
        "at": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "stop": {
      "type": "object",
      "required": [
        "contract_version",
        "blocker_id",
        "introduced_by",
        "requirement",
        "rationale",
        "qualifies_when",
        "does_not_qualify",
        "diagnostics_completed",
        "owner",
        "next_permitted_probe",
        "retry_policy",
        "input_route",
        "baseline_observation_fingerprint"
      ],
      "properties": {
        "contract_version": {"const": 2},
        "blocker_id": {"type": "string", "minLength": 1},
        "introduced_by": {"$ref": "#/$defs/introducedBy"},
        "requirement": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "qualifies_when": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "does_not_qualify": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "diagnostics_completed": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "owner": {"type": "string", "minLength": 1},
        "next_permitted_probe": {"type": "string", "minLength": 1},
        "retry_policy": {"type": "string", "minLength": 1},
        "input_route": {
          "type": "object",
          "required": ["destination", "format"],
          "properties": {
            "destination": {"type": "string", "minLength": 1},
            "format": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        },
        "baseline_observation_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      },
      "additionalProperties": true
    },
    "repository": {
      "type": "object",
      "required": [
        "repository_id",
        "project_name",
        "state",
        "progress",
        "roadmap",
        "why",
        "owner",
        "next_move"
      ],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1},
        "project_name": {"type": "string", "minLength": 1},
        "state": {
          "enum": [
            "RUNNING",
            "READY",
            "WAITING_USER",
            "WAITING_EXTERNAL",
            "SYSTEM_BLOCKED",
            "MISSION_COMPLETE_NEXT_UNSELECTED",
            "PARKED_BY_POLICY",
            "PROJECT_COMPLETE"
          ]
        },
        "progress": {
          "type": "object",
          "required": ["current_stage", "completed_stages"],
          "properties": {
            "current_stage": {"$ref": "#/$defs/stage"},
            "completed_stages": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/stage"}
            },
            "stage_labels": {"type": "object"}
          },
          "additionalProperties": true
        },
        "roadmap": {"$ref": "#/$defs/roadmap"},
        "why": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "next_move": {"type": "string", "minLength": 1},
        "stop": {"$ref": "#/$defs/stop"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {"enum": ["SYSTEM_BLOCKED", "PARKED_BY_POLICY"]}
            },
            "required": ["state"]
          },
          "then": {"required": ["stop"]}
        }
      ],
      "additionalProperties": true
    }
  }
}
