{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "supervise-repo-loop/coordinator-portfolio.v4",
  "title": "Project-context and frontier certified Coordinator portfolio v4",
  "type": "object",
  "required": [
    "schema_version", "semantic_fingerprint", "coordinator_availability",
    "execution_state", "scheduler_revision", "frontier_revision",
    "frontier_safety_mode", "project_context_revision",
    "project_context_safety_mode", "active_route_count", "active_routes",
    "concurrency_limit", "next_user_action", "repositories"
  ],
  "properties": {
    "schema_version": {"const": 4},
    "semantic_fingerprint": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "coordinator_availability": {"const": "AVAILABLE"},
    "execution_state": {"enum": ["READY", "DRAINING", "WAITING_USER", "WAITING_EXTERNAL", "IDLE", "SAFETY_CEILING"]},
    "scheduler_revision": {"type": "integer", "minimum": 0},
    "frontier_revision": {"type": "integer", "minimum": 0},
    "frontier_safety_mode": {"enum": ["TRANSPORT_ONLY_RECONCILIATION", "FRONTIER_VERIFIED"]},
    "project_context_revision": {"type": "integer", "minimum": 0},
    "project_context_safety_mode": {"enum": ["CONTEXT_RECONCILIATION_REQUIRED", "PROJECT_CONTEXT_VERIFIED"]},
    "active_route_count": {"type": "integer", "minimum": 0},
    "active_routes": {"type": "array", "items": {"type": "object"}},
    "concurrency_limit": {"type": "integer", "minimum": 1, "maximum": 8},
    "next_user_action": {"type": ["object", "null"]},
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repository_id", "project_name", "state", "progress", "roadmap",
          "why", "owner", "next_move", "frontier_status",
          "frontier_certificate", "frontier_epoch", "frontier_disposition",
          "active_artifact", "project_context_status",
          "project_context_revision", "project_context_event_id",
          "project_context"
        ],
        "properties": {
          "repository_id": {"type": "string", "minLength": 1},
          "project_name": {"type": "string", "minLength": 1},
          "state": {"enum": ["RUNNING", "READY", "WAITING_USER", "WAITING_EXTERNAL", "SYSTEM_BLOCKED", "MISSION_COMPLETE_NEXT_UNSELECTED", "PARKED_BY_POLICY", "PROJECT_COMPLETE"]},
          "progress": {"type": "object"},
          "roadmap": {"type": "object"},
          "why": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "next_move": {"type": "string", "minLength": 1},
          "frontier_status": {"enum": ["verified", "legacy_unverified", "reconciliation_required"]},
          "frontier_certificate": {"type": ["object", "null"]},
          "frontier_epoch": {"type": ["integer", "null"], "minimum": 1},
          "frontier_disposition": {"type": ["string", "null"]},
          "active_artifact": {"type": ["object", "null"]},
          "project_context_status": {"enum": ["verified", "legacy_unverified", "reconciliation_required", "authority_conflict"]},
          "project_context_revision": {"type": ["integer", "null"], "minimum": 1},
          "project_context_event_id": {"type": ["string", "null"], "minLength": 1},
          "project_context": {"type": ["object", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
