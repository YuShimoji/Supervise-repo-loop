{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "supervise-repo-loop/worker-report.v2",
  "title": "Worker Report v2",
  "type": "object",
  "required": [
    "repository_id",
    "mission_id",
    "attempt_id",
    "worker_task_id",
    "host_id",
    "result_classification",
    "active_artifact",
    "verification_summary",
    "deviations",
    "bounded_blocker",
    "suggested_decision_type",
    "git_state",
    "external_effect_state",
    "full_worker_report"
  ],
  "properties": {
    "repository_id": {
      "type": "string",
      "minLength": 1
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {},
    "worker_task_id": {
      "type": "string",
      "minLength": 1
    },
    "host_id": {
      "type": "string",
      "minLength": 1
    },
    "result_classification": {
      "type": "string",
      "minLength": 1
    },
    "active_artifact": {},
    "verification_summary": {},
    "deviations": {},
    "bounded_blocker": {},
    "suggested_decision_type": {},
    "git_state": {},
    "external_effect_state": {
      "type": "object",
      "required": [
        "transport",
        "recipient_open",
        "upload",
        "publication",
        "release"
      ],
      "additionalProperties": {
        "enum": ["not_required", "pending", "complete", "blocked", "unverified"]
      }
    },
    "full_worker_report": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
