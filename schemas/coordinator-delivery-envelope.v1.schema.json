{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "supervise-repo-loop/coordinator-delivery-envelope.v1",
  "title": "Coordinator idempotent external delivery envelope v1",
  "type": "object",
  "required": ["protocol", "action_id", "delivery_token", "payload_sha256"],
  "properties": {
    "protocol": {"const": "supervise-repo-loop/delivery-v1"},
    "action_id": {"type": "string", "minLength": 32},
    "delivery_token": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    }
  },
  "additionalProperties": false
}
