{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "supervise-repo-loop/mission-state.v2",
  "title": "Mission state v2",
  "type": "object",
  "required": [
    "schema_version",
    "repository_id",
    "launch_set_id",
    "mission_id",
    "attempt_id",
    "worker_task_id",
    "host_id",
    "supervisor_thread_id",
    "supervision_lane",
    "mode",
    "state",
    "mission_status",
    "review_status",
    "external_effects",
    "dispatch_keys",
    "returned_report_hashes",
    "completed_worker_turns",
    "safety_ceiling",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "mode": {
      "enum": ["coordinator", "worker", "single-thread", "binding-repair"]
    },
    "mission_status": {
      "enum": [
        "pending",
        "running",
        "complete",
        "blocked",
        "rejected",
        "superseded"
      ]
    },
    "review_status": {
      "enum": [
        "not_required",
        "pending",
        "accepted",
        "bounded_repair",
        "rejected"
      ]
    },
    "review_policy": {
      "type": "object",
      "required": ["gate", "depth", "stage"],
      "properties": {
        "gate": {
          "enum": ["none", "required"]
        },
        "depth": {
          "enum": ["light", "standard", "deep"]
        },
        "stage": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "user_response_ready": {
      "type": "boolean"
    },
    "queued_user_response_id": {
      "type": "string",
      "minLength": 1
    },
    "last_routed_user_response_id": {
      "type": "string",
      "minLength": 1
    },
    "blocked_contract": {
      "type": "object",
      "required": [
        "contract_version",
        "blocker_id",
        "introduced_by",
        "requirement",
        "rationale",
        "qualifies_when",
        "does_not_qualify",
        "diagnostics_completed",
        "owner",
        "next_permitted_probe",
        "retry_policy",
        "input_route",
        "baseline_observation_fingerprint"
      ],
      "properties": {
        "contract_version": {"const": 2},
        "blocker_id": {"type": "string", "minLength": 1},
        "classification": {"type": "string"},
        "introduced_by": {
          "type": "object",
          "required": ["event", "at", "evidence"],
          "properties": {
            "event": {"type": "string", "minLength": 1},
            "at": {"type": "string", "minLength": 1},
            "evidence": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        },
        "requirement": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "qualifies_when": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "does_not_qualify": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "diagnostics_completed": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "baseline_observation_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "supersedes_contract_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "revision_authority": {
          "type": "object",
          "required": [
            "event_kind",
            "event_id",
            "repository_id",
            "mission_id",
            "attempt_id",
            "supervisor_thread_id",
            "evidence_sha256"
          ],
          "properties": {
            "event_kind": {"type": "string", "minLength": 1},
            "event_id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$"
            },
            "repository_id": {"type": "string", "minLength": 1},
            "mission_id": {"type": "string", "minLength": 1},
            "attempt_id": {},
            "supervisor_thread_id": {"type": "string", "minLength": 1},
            "evidence_sha256": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$"
            }
          },
          "additionalProperties": false
        },
        "recovery_probe_id": {"type": "string"},
        "retry_policy": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "next_permitted_probe": {"type": "string", "minLength": 1},
        "input_route": {
          "type": "object",
          "required": ["destination", "format"],
          "properties": {
            "destination": {"type": "string", "minLength": 1},
            "format": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        },
        "next_on_recovery": {"type": "string"}
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {"required": ["supersedes_contract_fingerprint"]},
          "then": {"required": ["revision_authority"]}
        }
      ]
    },
    "blocked_contract_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "contract",
          "contract_fingerprint",
          "superseded_at",
          "superseded_by_contract_fingerprint"
        ],
        "properties": {
          "contract": {"$ref": "#/properties/blocked_contract"},
          "contract_fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "superseded_at": {"type": "string", "minLength": 1},
          "superseded_by_contract_fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "external_effects": {
      "type": "object",
      "required": [
        "transport",
        "recipient_open",
        "upload",
        "publication",
        "release"
      ],
      "additionalProperties": {
        "enum": ["not_required", "pending", "complete", "blocked", "unverified"]
      }
    }
  },
  "additionalProperties": true
}
