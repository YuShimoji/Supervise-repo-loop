{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "supervise-repo-loop/coordinator-portfolio.v3",
  "title": "Frontier-certified Coordinator portfolio status v3",
  "type": "object",
  "required": [
    "schema_version",
    "semantic_fingerprint",
    "coordinator_availability",
    "execution_state",
    "scheduler_revision",
    "frontier_revision",
    "frontier_safety_mode",
    "active_route_count",
    "active_routes",
    "concurrency_limit",
    "next_user_action",
    "repositories"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "semantic_fingerprint": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "coordinator_availability": {"const": "AVAILABLE"},
    "execution_state": {
      "enum": ["READY", "DRAINING", "WAITING_USER", "WAITING_EXTERNAL", "IDLE", "SAFETY_CEILING"]
    },
    "scheduler_revision": {"type": "integer", "minimum": 0},
    "frontier_revision": {"type": "integer", "minimum": 0},
    "frontier_safety_mode": {"enum": ["TRANSPORT_ONLY_RECONCILIATION", "FRONTIER_VERIFIED"]},
    "active_route_count": {"type": "integer", "minimum": 0},
    "active_routes": {"type": "array", "items": {"type": "object"}},
    "concurrency_limit": {"type": "integer", "minimum": 1, "maximum": 8},
    "next_user_action": {"type": ["object", "null"]},
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repository_id",
          "project_name",
          "state",
          "progress",
          "roadmap",
          "why",
          "owner",
          "next_move",
          "frontier_status",
          "frontier_certificate",
          "frontier_epoch",
          "frontier_disposition",
          "active_artifact"
        ],
        "properties": {
          "repository_id": {"type": "string", "minLength": 1},
          "project_name": {"type": "string", "minLength": 1},
          "state": {
            "enum": ["RUNNING", "READY", "WAITING_USER", "WAITING_EXTERNAL", "SYSTEM_BLOCKED", "MISSION_COMPLETE_NEXT_UNSELECTED", "PARKED_BY_POLICY", "PROJECT_COMPLETE"]
          },
          "progress": {"type": "object"},
          "roadmap": {"type": "object"},
          "why": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "next_move": {"type": "string", "minLength": 1},
          "frontier_status": {"enum": ["verified", "legacy_unverified", "reconciliation_required"]},
          "frontier_certificate": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "required": ["certificate_id", "repository_id", "lane_id", "frontier_epoch", "frontier_event_id", "artifact_id", "artifact_revision", "artifact_sha256", "branch", "head_sha", "disposition", "source_actor", "authority_fingerprint"],
                "properties": {
                  "certificate_id": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
                  "repository_id": {"type": "string", "minLength": 1},
                  "lane_id": {"type": "string", "minLength": 1},
                  "frontier_epoch": {"type": "integer", "minimum": 1},
                  "frontier_event_id": {"type": "string", "minLength": 1},
                  "artifact_id": {"type": ["string", "null"]},
                  "artifact_revision": {"type": ["string", "null"]},
                  "artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
                  "branch": {"type": "string", "minLength": 1},
                  "head_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
                  "disposition": {"enum": ["active", "accepted", "rejected", "superseded", "parked", "none"]},
                  "source_actor": {"enum": ["human", "supervisor", "worker", "repo_observation", "coordinator"]},
                  "authority_fingerprint": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
                },
                "additionalProperties": true
              }
            ]
          },
          "frontier_epoch": {"type": ["integer", "null"], "minimum": 1},
          "frontier_disposition": {
            "type": ["string", "null"],
            "enum": ["active", "accepted", "rejected", "superseded", "parked", "none", null]
          },
          "active_artifact": {"type": ["object", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
