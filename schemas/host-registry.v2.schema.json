{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "supervise-repo-loop/host-registry.v2",
  "title": "Host registry v2",
  "type": "object",
  "required": ["schema_version", "hosts", "private_artifacts"],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "host_id",
          "aliases",
          "workspace_roots",
          "known_repository_roots",
          "available_worker_tasks",
          "capabilities",
          "last_seen_at"
        ],
        "properties": {
          "host_id": {
            "type": "string",
            "pattern": "^host-[0-9a-f-]+$"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "app_host_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "workspace_roots": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "known_repository_roots": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "available_worker_tasks": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "capabilities": {
            "type": "object"
          },
          "last_seen_at": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "private_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "repository_id",
          "host_id",
          "path",
          "sha256",
          "status",
          "last_verified_at"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "repository_id": {
            "type": "string",
            "minLength": 1
          },
          "host_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "enum": ["verified", "needs_verification", "missing", "invalid"]
          },
          "last_verified_at": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
